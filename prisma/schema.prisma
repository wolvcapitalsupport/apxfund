generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  password                 String
  fullName                 String
  phone                    String?
  country                  String?
  preferredLanguage        String?
  role                     Role            @default(USER)
  balance                  Float           @default(0)
  totalDeposited           Float           @default(0)
  totalProfit              Float           @default(0)
  totalWithdrawn           Float           @default(0)
  referralCode             String          @unique @default(cuid())
  referredBy               String?
  kycStatus                KycStatus       @default(NONE)
  kycRejectedNote          String?
  isActive                 Boolean         @default(true)
  withdrawalAccessOverride Boolean         @default(false)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  isEmailVerified          Boolean?        @default(false)
  emailVerifyOtp           String?
  emailVerifyOtpExpiry     DateTime?       @db.Timestamp(6)
  lastNudgedPlanId         String?
  lastNudgedAt             DateTime?       @db.Timestamp(6)
  adminBanner              String?
  adminBannerType          String?         @default("warning")
  starterCyclesUsed        Int?            @default(0)
  awaitingMigration        Boolean?        @default(false)
  lockedCapital            Float?          @default(0)
  apxBalance               Float           @default(0)
  apxRewards               Float           @default(0)
  apxRedemptions           ApxRedemption[]
  investments              Investment[]
  kycSubmissions           KycSubmission[]
  notifications            Notification[]
  transactions             Transaction[]
  apxWithdrawals           ApxWithdrawal[]

  @@map("users")
}

model Plan {
  id            String       @id @default(cuid())
  name          String       @unique
  roiPercent    Float
  minAmount     Float
  maxAmount     Float
  durationDays  Int
  referralBonus Float        @default(5)
  isActive      Boolean      @default(true)
  description   String?
  features      String[]     @default([])
  createdAt     DateTime     @default(now())
  investments   Investment[]

  @@map("plans")
}

model Investment {
  id                      String           @id @default(cuid())
  userId                  String
  planId                  String
  amount                  Float
  expectedProfit          Float
  status                  InvestmentStatus @default(ACTIVE)
  startDate               DateTime         @default(now())
  endDate                 DateTime
  completedAt             DateTime?
  createdAt               DateTime         @default(now())
  autoReinvest            Boolean          @default(true)
  isPaused                Boolean          @default(false)
  cycleNumber             Int?             @default(1)
  rolloverOptOut          Boolean?         @default(false)
  lastRoiProcessedAt      DateTime?
  legacyRoiPaidUsd        Float            @default(0)
  legacyRoiReviewRequired Boolean          @default(false)
  roiPaidUsd              Float            @default(0)
  roiPaidApx              Float            @default(0)
  principalReturnedUsd    Float            @default(0)
  maturityProcessedAt     DateTime?
  plan                    Plan             @relation(fields: [planId], references: [id])
  user                    User             @relation(fields: [userId], references: [id])
  transactions            Transaction[]

  @@map("investments")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Float
  currency       String            @default("USD")
  txHash         String?
  proofImageUrl  String?
  walletAddress  String?
  adminNote      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime          @default(now())
  network        String?
  updatedAt      DateTime          @default(now()) @updatedAt
  txProofHash    String?
  usdEquivalent  Float?
  conversionRate Float?
  investmentId   String?
  editedAt       DateTime?
  editedBy       String?
  deletedAt      DateTime?
  deletedBy      String?
  user           User              @relation(fields: [userId], references: [id])
  investment     Investment?       @relation(fields: [investmentId], references: [id])
  apxWithdrawal  ApxWithdrawal?

  @@index([type, currency])
  @@index([investmentId])
  @@map("transactions")
}

model ApxRedemption {
  id          String              @id @default(cuid())
  userId      String
  amount      Float
  rateUsd     Float
  usdValue    Float
  status      ApxRedemptionStatus @default(PENDING)
  adminNote   String?
  requestedAt DateTime            @default(now())
  reviewedAt  DateTime?
  settledAt   DateTime?
  user        User                @relation(fields: [userId], references: [id])

  @@index([requestedAt])
  @@index([status])
  @@index([userId])
  @@map("apx_redemptions")
}

model ApxWithdrawal {
  id            String              @id @default(cuid())
  userId        String
  transactionId String?             @unique
  amount        Float
  walletAddress String
  network       String              @default("BSC")
  status        ApxWithdrawalStatus @default(PENDING)
  txHash        String?
  adminNote     String?
  reviewedBy    String?
  requestedAt   DateTime            @default(now())
  reviewedAt    DateTime?
  paidAt        DateTime?
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id])
  transaction   Transaction?        @relation(fields: [transactionId], references: [id])

  @@index([status])
  @@index([userId, requestedAt])
  @@map("apx_withdrawals")
}

model KycSubmission {
  id             String    @id @default(cuid())
  userId         String
  documentType   String
  documentNumber String
  frontImageUrl  String
  backImageUrl   String?
  selfieUrl      String
  status         KycStatus @default(PENDING)
  adminNote      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  submittedAt    DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@map("kyc_submissions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model WalletAddress {
  id        String   @id @default(cuid())
  currency  String   @unique
  label     String
  address   String
  network   String   @default("mainnet")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("wallet_addresses")
}

model RoiProcessingLog {
  id                        String   @id @default(cuid())
  processedAt               DateTime @default(now())
  investmentsFound          Int
  investmentsDone           Int
  totalProfitPaid           Float
  errors                    String?
  totalApxPaid              Float    @default(0)
  totalUsdPrincipalReturned Float    @default(0)

  @@map("roi_processing_logs")
}

model EmailLog {
  id           String    @id @default(cuid())
  sentBy       String
  recipients   String[]
  subject      String
  bodyHtml     String
  sentAt       DateTime  @default(now())
  openedAt     DateTime?
  openCount    Int       @default(0)
  lastOpenedAt DateTime?
  trackingId   String    @unique @default(cuid())

  @@map("email_logs")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  entityType   String
  entityId     String?
  summary      String
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

enum Role {
  USER
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PROFIT
  REFERRAL_BONUS
  APX_BUY
  APX_REWARD
  APX_REDEEM
  REFERRAL
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ApxRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum ApxWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}
